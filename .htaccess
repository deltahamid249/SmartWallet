Options -Indexes

# منع عرض ملفات إعدادات ونسخ قاعدة البيانات الحساسة عبر المتصفح.
# ملاحظة: تنفيذ PHP نفسه يتم بواسطة Apache/PHP في XAMPP،
# لذلك يجب فتح المشروع عبر http://localhost وليس file:// أو Live Server.
<FilesMatch "\.(sql|env|log|ini|bak|backup)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

            line-height: 1.8;
            color: #7c2d12;
        }

        @media (max-width: 600px) {
            .container {
                width: min(100% - 20px, 900px);
                margin: 15px auto;
            }

            .topbar {
                align-items: stretch;
                flex-direction: column;
            }

            .topbar h1 {
                font-size: 21px;

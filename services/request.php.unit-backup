            flex-wrap: wrap;
        }

        .request-number {
            font-size: 14px;
            color: #64748b;
            margin-top: 7px;
            word-break: break-all;
        }

        .status {
            display: inline-block;
            padding: 9px 15px;
            border-radius: 999px;
            font-weight: 900;
            font-size: 14px;
        }

        .status.pending {
            background: #fff7ed;
            color: #c2410c;
        }

        .status.processing {
            background: #eff6ff;
            color: #1d4ed8;
        }

        .status.completed {

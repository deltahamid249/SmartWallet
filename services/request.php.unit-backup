                <span class="label">شركة الاتصالات</span>
                <span class="value"><?= detailValue($request['provider']) ?></span>
            </div>

            <div class="item">
                <span class="label">رقم الهاتف</span>
                <span class="value"><?= detailValue($request['phone_number']) ?></span>
            </div>

            <div class="item">
                <span class="label">رقم الحساب</span>
                <span class="value"><?= detailValue($request['account_number']) ?></span>
